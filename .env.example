# ProjectForge — provider configuration template
#
# Copy this file to .env and fill in YOUR OWN values. Never commit real credentials.
#   cp .env.example .env
#
# ProjectForge talks to Claude through the Claude Agent SDK, which reads the
# standard ANTHROPIC_* environment variables below. Any Anthropic-compatible
# endpoint works.

# --- Endpoint & authentication ---
# Provide either an API key or an auth token (whichever your provider issues).
ANTHROPIC_API_KEY=YOUR_API_KEY
ANTHROPIC_AUTH_TOKEN=YOUR_AUTH_TOKEN

# Base URL of the Anthropic-compatible endpoint. Leave unset to use the
# official Anthropic API.
ANTHROPIC_BASE_URL=YOUR_BASE_URL

# --- Model selection ---
ANTHROPIC_MODEL=YOUR_MODEL_ID

# Optional: override the model used by the Main Agent (falls back to the
# environment's model configuration when unset).
PROJECTFORGE_MODEL=

# Optional: pin the project root explicitly instead of walking up from the
# current working directory in search of package.json.
PROJECTFORGE_PROJECT_ROOT=
